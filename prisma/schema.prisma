// ============================================================
//  MS Trans — schéma Prisma
//  Gestion de flotte frigorifique (2 camions, extensible à N)
//  Stack : Next.js + Prisma + PostgreSQL
//  Multi-devise : GNF (base) + XOF (franc CFA, côté Sénégal)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Connexion applicative. Sur Neon, utiliser l'URL **avec pooler**
  /// (`-pooler` dans l'hôte) : les fonctions serverless ouvrent une connexion
  /// par invocation et saturent une base sans pool.
  url       = env("DATABASE_URL")
  /// Connexion directe, sans pooler. Les migrations créent des verrous que le
  /// pooler ne sait pas porter : sans cette URL, `migrate deploy` échoue.
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
//  DEVISES — le taux GNF/CFA VARIE (pas de taux fixe)
//  Pour chaque montant en devise étrangère, l'utilisateur saisit
//  l'équivalent GNF au taux RÉEL du moment (« 5 000 CFA = combien ? »).
//  Ce résultat est figé dans les champs `*Gnf`. Le taux appliqué se
//  relit à tout moment = `*Gnf` / montant. TauxChange ne sert que de
//  taux de référence (dernier connu) pour PRÉ-REMPLIR la saisie.
//  → le P&L, basé sur les `*Gnf` figés, reste stable dans le temps.
// ------------------------------------------------------------

enum Devise {
  GNF // franc guinéen (base)
  XOF // franc CFA — Sénégal / zone CFA
  // Extensible : si trajets hors zone CFA (Sierra Leone SLL/SLE, Liberia LRD…), ajouter ici.
}

// Pays desservis (voyages parfois internationaux — passage de frontière).
// Enum extensible : ajouter un pays = une ligne.
/// Pays desservis, saisis par l'exploitation.
///
/// Une liste figée dans le code obligeait à redéployer pour ouvrir un
/// corridor. Le pays porte aussi son indicatif téléphonique : ajouter un
/// pays rend du même coup ses numéros saisissables.
model Pays {
  id                String  @id @default(cuid())
  nom               String  @unique // « Guinée »
  /// Code ISO à deux lettres, repris sur les factures : « GN ».
  code              String  @unique
  /// Indicatif téléphonique avec le `+`.
  indicatif         String
  /// Longueur attendue du numéro national, pour signaler une saisie douteuse.
  longueurTelephone Int?
  actif             Boolean @default(true)
  ordre             Int     @default(0)

  voyagesDepart  Voyage[]            @relation("VoyageDepart")
  voyagesArrivee Voyage[]            @relation("VoyageArrivee")
  etapesDepart   EtapeVoyage[]       @relation("EtapeDepart")
  etapesArrivee  EtapeVoyage[]       @relation("EtapeArrivee")
  prelevements   PrelevementDouane[]

  createdAt DateTime @default(now())
}

model TauxChange {
  // Taux de RÉFÉRENCE (dernier connu) — sert uniquement à pré-remplir la saisie.
  // Le taux réellement appliqué est saisi par transaction (voir champs `*Gnf`).
  id        String   @id @default(cuid())
  devise    Devise // devise étrangère (ex : XOF)
  tauxEnGnf Decimal  @db.Decimal(14, 4) // nombre de GNF pour 1 unité de cette devise
  dateEffet DateTime @default(now())
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
//  PARC
// ------------------------------------------------------------

enum StatutCamion {
  DISPONIBLE
  EN_VOYAGE
  IMMOBILISE // en panne / réparation
  HORS_SERVICE
}

enum TypeVehicule {
  TRACTEUR_REMORQUE // tracteur routier + semi-remorque
  PORTEUR // camion porteur (rigide, sans remorque)
}

/// Carrosserie = ce que le véhicule transporte, indépendant du châssis.
/// Un porteur-benne et un tracteur + semi-benne sont deux véhicules
/// différents portant la même caisse : les deux dimensions sont distinctes.
enum Carrosserie {
  FRIGO // caisse frigorifique (groupe froid, chaîne du froid suivie)
  BENNE // benne basculante (sable, gravier, matériaux)
  PLATEAU // plateau nu
  BACHE // caisse bâchée / tautliner
  CITERNE // citerne
  /// Transport de personnes — prévu, pas encore exploité.
  /// Ces valeurs existent pour que la base soit prête, mais elles ne sont pas
  /// proposées à la saisie : le suivi propre aux passagers (places, billets,
  /// recette au voyageur) reste à construire, et les métriques en tonnes ou
  /// la chaîne du froid n'ont aucun sens ici.
  /// Voir `CARROSSERIES_DISPONIBLES` dans `src/lib/utils.ts`.
  BUS
  TAXI
}

model Camion {
  id                     String       @id @default(cuid())
  nom                    String // ex : "Camion 1"
  typeVehicule           TypeVehicule @default(TRACTEUR_REMORQUE)
  carrosserie            Carrosserie  @default(FRIGO)
  /// Dérivé de la carrosserie (FRIGO) et maintenu cohérent par les actions.
  /// Conservé comme champ car toute la chaîne du froid s'y réfère.
  refrigere              Boolean      @default(true) // false = non frigorifique (groupe froid / chaîne du froid ignorés)
  immatTracteur          String       @unique
  immatRemorque          String?      @unique
  marqueTracteur         String?
  // Téléphone de bord propre au camion, utilisé par le chauffeur (2 SIM : GN + SN/CFA)
  /// Photo du véhicule, en data URI (image redimensionnée à la saisie).
  /// Un chauffeur reconnaît son camion plus vite sur une image que sur une
  /// immatriculation, et le gérant repère une confusion d'un coup d'œil.
  photo                  String?
  telephoneBord1         String?
  telephoneBord2         String?
  // Groupe froid (reefer) — seulement si refrigere=true ; suivi en HEURES, pas en km
  marqueGroupeFroid      String?
  modeleGroupeFroid      String?
  heuresGroupeFroid      Int          @default(0)
  kilometrage            Int          @default(0)
  /**
   * Charge utile du véhicule, en tonnes.
   * Indicative, jamais bloquante : sur le terrain un porteur non frigorifique
   * part régulièrement au-dessus de sa charge utile. Refuser la saisie
   * ferait sortir la mission de l'application au lieu de la documenter. Elle
   * sert à signaler le dépassement, pas à l'empêcher.
   */
  capaciteTonnes         Decimal?     @db.Decimal(8, 2)
  // Acquisition & amortissement (coût de possession)
  coutAcquisition        Decimal?     @db.Decimal(16, 2) // prix d'achat du camion (GNF)
  dateAcquisition        DateTime?
  dureeAmortissementMois Int?         @default(60) // amortissement linéaire (ex. 5 ans)
  statut                 StatutCamion @default(DISPONIBLE)
  actif                  Boolean      @default(true)
  createdAt              DateTime     @default(now())

  voyages     Voyage[]
  depenses    Depense[]
  reparations Reparation[]
  entretiens  Entretien[]
  echeances   Echeance[]
  alertes     Alerte[]
}

// ------------------------------------------------------------
//  UTILISATEURS & RÔLES
//  Le gérant pilote tout ; les chauffeurs se connectent depuis
//  leur téléphone pour saisir eux-mêmes départs de mission,
//  dépenses et carburant. (Auth gérée par Auth.js.)
// ------------------------------------------------------------

enum Role {
  GERANT // propriétaire / exploitation — accès complet
  EXPLOITANT // chef d'exploitation : voyages, parc, frais de route
  COMPTABLE // facturation, encaissements, clients, dépenses
  LECTEUR // consultation seule : associé, bailleur, comptable externe
  CHAUFFEUR // accès limité : ses missions, ses dépenses, sa caisse
}

model Utilisateur {
  id         String   @id @default(cuid())
  nom        String
  telephone  String?  @unique
  email      String?  @unique
  // Empreinte du mot de passe (scrypt) — jamais le mot de passe en clair.
  // Requis par le provider « identifiants » d'Auth.js (connexion téléphone + mot de passe).
  motDePasse String?
  role       Role     @default(CHAUFFEUR)
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())

  // un compte CHAUFFEUR est rattaché à une fiche Chauffeur
  chauffeur   Chauffeur? @relation(fields: [chauffeurId], references: [id])
  chauffeurId String?    @unique
  /// Opérations tracées à son nom.
  journal     Journal[]
}

// ------------------------------------------------------------
//  CHAUFFEURS
// ------------------------------------------------------------

enum ModeRemuneration {
  FORFAIT_VOYAGE // montant fixe par voyage
  COMMISSION // % de la recette du voyage
  PAR_KM // montant par km
  FIXE_MENSUEL // salaire fixe
  MIXTE // fixe + variable
}

model Chauffeur {
  id                   String           @id @default(cuid())
  nom                  String
  telephone            String?          @unique
  numeroPermis         String?
  categoriePermis      String?          @default("CE")
  permisExpire         DateTime?
  /// Photo d'identité, stockée en data URI (image redimensionnée à la saisie).
  ///
  /// Conservée en base plutôt que sur disque : le système de fichiers de
  /// Vercel est en lecture seule, et un stockage objet serait une dépendance
  /// de plus pour quelques dizaines de kilo-octets par chauffeur.
  photo                String?
  /// Indemnité de nourriture par jour, propre à ce chauffeur.
  /// Sert à pré-remplir les missions ; le montant convenu par mission prime.
  perDiemJournalierGnf Decimal?         @db.Decimal(14, 2)
  modeRemuneration     ModeRemuneration @default(FORFAIT_VOYAGE)
  tauxRemuneration     Decimal?         @db.Decimal(12, 2) // montant/voyage, %/recette ou montant/km selon le mode
  actif                Boolean          @default(true)
  createdAt            DateTime         @default(now())

  voyages          Voyage[]
  depenses         Depense[]
  mouvementsCaisse MouvementCaisse[]
  alertes          Alerte[]
  utilisateur      Utilisateur?
  notifications    NotificationSms[]
  whatsapp         Boolean              @default(false)
  whatsappNumero   String?
  /// Saisies hors ligne déjà appliquées — garde-fou anti-doublon au rejeu.
  operations       OperationChauffeur[]
  compteTresorerie CompteTresorerie?
}

// ------------------------------------------------------------
//  VOYAGES
// ------------------------------------------------------------

enum StatutVoyage {
  PLANIFIE
  /// Le chauffeur a déclaré son départ : il roule vers le point de chargement.
  /// Sans cet état, une mission restait « planifiée » alors que le camion était
  /// déjà sur la route depuis des heures.
  EN_ROUTE_CHARGEMENT
  EN_ATTENTE_CHARGEMENT // parti chercher la marchandise, attend le chargement
  EN_COURS
  ARRIVE_DESTINATION // arrivé à destination
  EN_DECHARGEMENT // en cours de débarquement de la marchandise
  TERMINE
  ANNULE
}

/// Unité de mesure d'une marchandise.
///
/// La tonne ne suffit pas : on charge aussi des sacs, des cartons, des têtes de
/// bétail, des mètres cubes. Les unités sont donc saisies par l'exploitation
/// plutôt que figées dans le code.
model Unite {
  id           String   @id @default(cuid())
  nom          String   @unique // « Tonne », « Sac de 50 kg »
  symbole      String // « t », « sac »
  /// Équivalent en tonnes d'une unité, quand la conversion a un sens.
  /// Renseigné, il permet de totaliser un chargement mixte en tonnage.
  /// Laissé vide pour ce qui ne se pèse pas (tête de bétail, palette).
  facteurTonne Decimal? @db.Decimal(12, 6)
  actif        Boolean  @default(true)
  /// Ordre d'apparition dans les listes déroulantes.
  ordre        Int      @default(0)

  lignes LigneMarchandise[]

  createdAt DateTime @default(now())
}

/// Une marchandise d'un voyage.
///
/// Un même camion transporte souvent plusieurs marchandises pour un même
/// trajet — parfois pour des clients différents. Chaque ligne porte sa propre
/// unité et son propre suivi chargé → reçu → livré : c'est la seule façon de
/// situer un manquant sur la bonne marchandise plutôt que sur un total qui ne
/// veut rien dire quand les unités diffèrent.
/// Statut de la livraison d'une marchandise, tel qu'il apparaît sur la facture.
enum StatutLivraison {
  EN_ATTENTE // pas encore livrée
  CONFORME // livrée, quantité conforme après déduction des prélèvements
  NON_CONFORME // livrée, mais avec un manquant inexpliqué
}

model LigneMarchandise {
  id          String @id @default(cuid())
  voyage      Voyage @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  voyageId    String
  designation String
  unite       Unite  @relation(fields: [uniteId], references: [id])
  uniteId     String

  quantiteACharger Decimal? @db.Decimal(14, 3) // prévue à la mission
  quantiteRecue    Decimal? @db.Decimal(14, 3) // constatée par le chauffeur au chargement
  quantiteLivree   Decimal? @db.Decimal(14, 3) // remise à destination

  /// Destinataire, lorsqu'un voyage groupe les marchandises de plusieurs
  /// clients. Vide = le client principal du voyage.
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?
  ordre    Int     @default(0)

  /**
   * --- Preuve de livraison ---
   * Le client reçoit un code par SMS ou WhatsApp, le communique au chauffeur
   * à la remise, et le chauffeur le saisit. C'est ce qui atteste que la
   * marchandise a bien été remise à son destinataire : une quantité saisie
   * par le seul chauffeur ne prouve rien en cas de contestation.
   */
  /// Code attendu. Généré à l'expédition, jamais montré au chauffeur.
  codeLivraison  String?
  /// Nombre d'envois du code — le client peut en redemander un.
  codeEnvois     Int       @default(0)
  codeEnvoyeLe   DateTime?
  /// Horodatage de la saisie correcte par le chauffeur.
  codeConfirmeLe DateTime?
  /// Tentatives ratées, pour repérer une saisie au hasard.
  codeTentatives Int       @default(0)

  prelevements PrelevementDouane[]
  reclamations Reclamation[]

  createdAt DateTime @default(now())

  @@index([voyageId])
}

/// Raison d'être d'une mission.
///
/// Toutes ne transportent pas : on roule aussi pour aller réparer le camion,
/// le repositionner, ou chercher une marchandise. La distinction commande le
/// reste — un trajet d'atelier ne se facture pas et ne se rémunère pas comme
/// un transport.
enum MotifVoyage {
  TRANSPORT // course classique, chargée
  RECUPERATION_MARCHANDISE // part à vide chercher le chargement d'un client
  REPARATION // va à l'atelier
  REPOSITIONNEMENT // ramène le camion là où il servira
  AUTRE
}

model Voyage {
  id          String    @id @default(cuid())
  reference   String    @unique @default(cuid())
  camion      Camion    @relation(fields: [camionId], references: [id])
  camionId    String
  chauffeur   Chauffeur @relation(fields: [chauffeurId], references: [id])
  chauffeurId String

  paysDepart    Pays?    @relation("VoyageDepart", fields: [paysDepartId], references: [id], onDelete: SetNull)
  paysDepartId  String?
  villeDepart   String
  paysArrivee   Pays?    @relation("VoyageArrivee", fields: [paysArriveeId], references: [id], onDelete: SetNull)
  paysArriveeId String?
  villeArrivee  String
  // international = (paysDepart != paysArrivee) — calculé côté app
  /// Client principal de la mission.
  ///
  /// Vraie liaison et non plus du texte libre : sans elle, impossible de
  /// partir d'un client pour voir ses missions, ni de lui préparer une facture
  /// depuis sa fiche. Deux orthographes du même nom créaient deux clients.
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId      String?
  /// Bennes : une mission couvre une journée de rotations sur le même trajet.
  /// `distanceKm` et les quantités valent alors POUR UNE rotation ; les totaux
  /// se multiplient par `nbRotations`. Vaut 1 pour un transport classique.
  nbRotations   Int      @default(1)
  /**
   * La mission comporte-t-elle un retour en charge ou à vide ?
   * Un aller-retour ne se déduit pas du trajet : Conakry → Dakar → Conakry
   * s'enregistre comme une seule mission, et c'est le carburant du retour qui
   * fait la différence entre une course rentable et une course à perte.
   */
  allerRetour   Boolean  @default(false)
  /// Si renseigné, la recette vaut tarifRotation × nbRotations.
  tarifRotation Decimal? @db.Decimal(14, 2)

  /// Départ sans chargement.
  ///
  /// Deux cas distincts : un simple repositionnement du camion, ou l'aller
  /// d'une mission — on part à vide CHERCHER la marchandise d'un client.
  /// Dans le second cas le voyage porte quand même son client : la course
  /// lui est imputable même si rien n'est chargé au départ.
  aVide      Boolean     @default(false)
  /// Vrai quand le trajet à vide sert à aller chercher la marchandise du
  /// client ci-dessus. Distingue la course utile du repositionnement.
  vaChercher Boolean     @default(false)
  /// Ce pour quoi le camion roule. Détermine ce qu'on attend de la mission.
  motif      MotifVoyage @default(TRANSPORT)

  /**
   * Le chauffeur est-il payé pour cette mission ?
   * Un aller à l'atelier ne se rémunère pas forcément : il touche alors ses
   * seuls frais de route. Sans ce drapeau, l'application estimait sa paie
   * depuis son forfait et faisait apparaître le camion lourdement déficitaire
   * sur une course qui ne rapportait rien par nature.
   */
  remunererChauffeur Boolean @default(true)

  /**
   * Indemnité de nourriture, par jour de mission.
   * Se compte au jour, pas au voyage : une course de trois jours nourrit trois
   * jours. Pré-remplie depuis la fiche du chauffeur, ajustable ici — le
   * montant réellement convenu prime sur le barème.
   */
  perDiemJournalierGnf Decimal? @db.Decimal(14, 2)
  distanceKm           Int?

  dateDepart             DateTime
  dateArrivee            DateTime?
  kmDepart               Int? // relevé compteur au départ de mission
  kmArrivee              Int? // relevé au retour — distance réelle + conso
  // Aller chercher la marchandise : attente possible de plusieurs jours avant le chargement
  dateArriveeChargement  DateTime? // arrivée au point de chargement
  dateChargement         DateTime? // chargement effectif (écart = jours d'attente)
  dateArriveeDestination DateTime? // arrivé à destination
  dateDechargement       DateTime? // début du débarquement de la marchandise

  /**
   * Compteur relevé à chaque étape, par le chauffeur.
   * La distance ne se saisit pas à la création : personne ne la connaît
   * d'avance, et un chiffre estimé fausserait tous les coûts au kilomètre.
   * Elle se déduit des relevés — approche au chargement, trajet en charge,
   * déchargement — qui donnent aussi la distance à vide de chaque segment.
   */
  kmArriveeChargement  Int?
  kmChargement         Int?
  kmArriveeDestination Int?
  kmDechargement       Int?

  /**
   * Annulation : pourquoi, et quand.
   * Une mission annulée n'est pas effacée — le client a pu se désister après
   * qu'on ait engagé du gasoil et une avance, et ces montants doivent rester
   * traçables. Sans motif écrit, personne ne se souvient trois semaines plus
   * tard si c'est le client qui a renoncé ou le camion qui est tombé en panne.
   */
  motifAnnulation String?
  annuleLe        DateTime?

  // recette dans la devise réelle + équivalent GNF figé
  recette               Decimal  @default(0) @db.Decimal(14, 2)
  devise                Devise   @default(GNF)
  recetteGnf            Decimal  @default(0) @db.Decimal(16, 2)
  remunerationChauffeur Decimal? @db.Decimal(14, 2) // paie du chauffeur pour ce voyage (variable, GNF)

  statut    StatutVoyage @default(PLANIFIE)
  createdAt DateTime     @default(now())

  depenses      Depense[]
  alertes       Alerte[]
  etapes        EtapeVoyage[]
  relevesTemp   ReleveTemperature[]
  factures      Facture[]
  reclamations  Reclamation[]
  notifications NotificationSms[]
  prelevements  PrelevementDouane[]
  lignes        LigneMarchandise[]
  /// Avances de caisse remises pour cette mission.
  avances       MouvementCaisse[]
}

// ------------------------------------------------------------
//  DÉPENSES  (typées pour obtenir les vrais coûts)
// ------------------------------------------------------------

/**
 * Étage d'une charge.
 * Trois natures qui ne se pilotent pas de la même façon : ce qu'une mission
 * consomme, ce qu'un véhicule coûte qu'il roule ou non, et ce que l'entreprise
 * dépense pour exister. Les mélanger empêche de dire d'où vient une dérive.
 */
enum CategorieDepense {
  DIRECTE // imputable à une mission précise
  VEHICULE // liée au camion, pas à un trajet
  ADMINISTRATIVE // fonctionnement du bureau
  GENERALE // autres charges de structure
}

enum TypeDepense {
  // --- Directes : consommées par une mission ---
  GASOIL_TRACTEUR
  GASOIL_GROUPE_FROID // le groupe froid consomme son propre gasoil
  PEAGE
  FRONTIERE // frais de passage frontière (souvent payés en XOF)
  DOUANE // dédouanement / transit à la sortie/entrée
  PER_DIEM
  HEBERGEMENT
  STATIONNEMENT
  CHARGEMENT_DECHARGEMENT
  TRAVERSEE // bac, ferry
  COMMISSION
  PRIME_CHAUFFEUR
  INTERNET // forfait data du téléphone de bord — coût variable selon la localisation du camion
  DIVERS

  // --- Véhicule : dues au camion, pas au trajet ---
  PIECES_RECHANGE
  IMMATRICULATION
  AUTRE_VEHICULE

  // --- Administratives et générales : l'entreprise, pas la route ---
  LOYER
  SALAIRE_ADMINISTRATIF
  ELECTRICITE
  TELECOMMUNICATIONS
  LOGICIEL_ABONNEMENT
  COMPTABILITE
  MARKETING
  FOURNITURES_BUREAU
  MAINTENANCE_LOCAUX
  FRAIS_BANCAIRES
  IMPOTS_TAXES
  AUTRE_GENERAL
}

model Depense {
  id             String           @id @default(cuid())
  type           TypeDepense
  /**
   * Étage de la charge. Déduit du type à la saisie, mais stocké : c'est lui
   * qui structure le compte de résultat, et un type peut changer d'étage sans
   * qu'on veuille réécrire l'historique.
   */
  categorie      CategorieDepense @default(DIRECTE)
  montant        Decimal          @db.Decimal(14, 2) // dans la devise réelle
  devise         Devise           @default(GNF)
  montantGnf     Decimal          @default(0) @db.Decimal(16, 2) // équivalent GNF figé
  litres         Decimal?         @db.Decimal(8, 2) // litres ajoutés lors d'un plein (ravitaillement)
  releveCompteur Int? // km (tracteur) ou heures (groupe froid) au plein — pour la conso
  description    String?
  /// Comment la dépense a été réglée : espèces, Orange Money, virement…
  /// Sert à retrouver l'opération dans un relevé et à la justifier.
  /// Comment l'argent a circulé. Facultatif : une écriture dérivée — le
  /// carburant remis avec la mission, par exemple — n'a pas de moyen déclaré,
  /// et inventer « espèces » ferait entrer une donnée fausse dans la caisse.
  moyen          MoyenPaiement?   @relation(fields: [moyenId], references: [id])
  moyenId        String?
  /// Référence du transfert, identifiant Orange Money, n° de reçu.
  reference      String?
  date           DateTime         @default(now())

  voyage          Voyage?        @relation(fields: [voyageId], references: [id])
  voyageId        String?
  /**
   * Cette dépense pèse-t-elle sur la marge de la mission ?
   * Une réparation engagée pendant un voyage n'est pas un coût de ce
   * voyage : la pièce sert au camion pendant des mois. L'imputer ferait
   * plonger la marge d'une mission au hasard de la panne, et laisserait
   * croire que la ligne n'est pas rentable. Les dépenses de catégorie
   * véhicule arrivent donc à `false`, sauf indication contraire à la saisie.
   */
  imputerAMission Boolean        @default(true)
  /**
   * Segment concerné, pour le carburant surtout.
   * Renseigné, il permet de comparer ce que l'aller et le retour ont coûté.
   * Laissé vide sur une mission simple, où la question ne se pose pas.
   */
  segment         SegmentTrajet?
  camion          Camion?        @relation(fields: [camionId], references: [id])
  camionId        String?
  etape           EtapeVoyage?   @relation(fields: [etapeId], references: [id]) // plein rattaché à une étape
  /// Rattachements analytiques facultatifs, pour ventiler au-delà du camion.
  chauffeur       Chauffeur?     @relation(fields: [chauffeurId], references: [id], onDelete: SetNull)
  chauffeurId     String?
  client          Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId        String?
  etapeId         String?

  // si la dépense a été payée depuis la caisse du chauffeur
  mouvementCaisse MouvementCaisse?

  createdAt DateTime          @default(now())
  /// D'où l'argent est sorti.
  compte    CompteTresorerie? @relation(fields: [compteId], references: [id])
  compteId  String?
}

// ------------------------------------------------------------
//  RÉPARATIONS & ENTRETIEN
// ------------------------------------------------------------

enum CategorieReparation {
  TRACTEUR
  REMORQUE
  GROUPE_FROID // panne critique : chaîne du froid rompue = marchandise perdue
  PNEUMATIQUE
}

enum StatutReparation {
  A_FAIRE
  EN_COURS
  TERMINEE
}

// Réparation CURATIVE (panne)
model Reparation {
  id             String              @id @default(cuid())
  camion         Camion              @relation(fields: [camionId], references: [id])
  camionId       String
  categorie      CategorieReparation
  description    String
  garage         String? // garage ou mécanicien (peut être au Sénégal)
  coutPieces     Decimal             @default(0) @db.Decimal(14, 2)
  coutMainOeuvre Decimal             @default(0) @db.Decimal(14, 2)
  devise         Devise              @default(GNF)
  coutTotalGnf   Decimal             @default(0) @db.Decimal(16, 2) // (pièces + main d'œuvre) en GNF
  kilometrage    Int?
  heuresGroupe   Int? // relevé horaire si panne groupe froid
  immobiliseDu   DateTime? // début d'immobilisation
  immobiliseAu   DateTime? // fin — sert à calculer les jours d'arrêt (coût caché)
  statut         StatutReparation    @default(EN_COURS)
  createdAt      DateTime            @default(now())
}

enum TypeEntretien {
  VIDANGE_TRACTEUR
  ENTRETIEN_GROUPE_FROID
  FREINS
  PNEUS
  AUTRE
}

// Entretien PRÉVENTIF (planifié) — déclenche des alertes à échéance
model Entretien {
  id             String        @id @default(cuid())
  camion         Camion        @relation(fields: [camionId], references: [id])
  camionId       String
  type           TypeEntretien
  dateFait       DateTime?
  kmFait         Int?
  heuresFait     Int?
  // prochaine échéance : par km, par heures OU par date selon le type
  prochainKm     Int?
  prochainHeures Int?
  prochaineDate  DateTime?
  cout           Decimal       @default(0) @db.Decimal(14, 2)
  devise         Devise        @default(GNF)
  coutGnf        Decimal       @default(0) @db.Decimal(16, 2)
  createdAt      DateTime      @default(now())
}

// ------------------------------------------------------------
//  CAISSE CHAUFFEUR  (le différenciateur, multi-devise)
//  Un chauffeur peut détenir du GNF ET du XOF en même temps.
//  → solde calculé PAR devise (réconciliation cash physique)
//    ET consolidé en GNF (via montantGnf) pour la compta.
// ------------------------------------------------------------

enum TypeMouvement {
  AVANCE // argent remis au chauffeur
  DEPENSE // dépense justifiée (déduite du solde)
  REMBOURSEMENT // le chauffeur rend le reliquat
}

model MouvementCaisse {
  id          String         @id @default(cuid())
  chauffeur   Chauffeur      @relation(fields: [chauffeurId], references: [id])
  chauffeurId String
  type        TypeMouvement
  montant     Decimal        @db.Decimal(14, 2) // dans la devise réelle
  devise      Devise         @default(GNF)
  montantGnf  Decimal        @default(0) @db.Decimal(16, 2) // équivalent GNF figé
  motif       String?
  /**
   * Ce à quoi l'argent est destiné : gasoil, nourriture, réparation…
   * Une avance n'est presque jamais une somme unique : le gérant remet un
   * montant pour la route, un autre pour manger, un autre pour une réparation
   * prévue. Sans cette ventilation, le chauffeur reçoit un total qu'il ne sait
   * pas rattacher, et personne ne peut dire si ce qui était prévu pour la
   * nourriture a servi au gasoil.
   */
  objet       TypeDepense?
  /// Comment l'argent a circulé : espèces de la main à la main, Orange Money,
  /// virement… Nécessaire pour retrouver une opération et la justifier.
  moyen       MoyenPaiement? @relation(fields: [moyenId], references: [id])
  moyenId     String?
  /// Référence du transfert, identifiant Orange Money, n° de chèque.
  reference   String?
  /**
   * Frais prélevés par l'opérateur sur l'envoi.
   * Envoyer 2 000 000 par Orange Money n'en coûte pas 2 000 000 : la
   * commission est un vrai coût d'exploitation. Comptée à part, elle ne se
   * confond pas avec l'argent remis au chauffeur, qui devra le justifier.
   */
  fraisGnf    Decimal?       @db.Decimal(14, 2)
  date        DateTime       @default(now())

  depense   Depense? @relation(fields: [depenseId], references: [id])
  depenseId String?  @unique

  /// Mission que cette avance finance.
  ///
  /// Sans ce rattachement, l'argent remis pour un Conakry–Dakar se confond
  /// avec celui d'une autre course : impossible de dire ce qu'un voyage a
  /// réellement coûté en trésorerie, ni ce qu'il reste à justifier dessus.
  voyage   Voyage?           @relation(fields: [voyageId], references: [id], onDelete: SetNull)
  voyageId String?
  /// Compte d'où l'avance a été tirée, ou vers lequel le reliquat revient.
  compte   CompteTresorerie? @relation(fields: [compteId], references: [id])
  compteId String?

  @@index([voyageId])
}

// ------------------------------------------------------------
//  ÉCHÉANCES / DOCUMENTS  (alertes)
// ------------------------------------------------------------

enum TypeEcheance {
  ASSURANCE
  VISITE_TECHNIQUE
  VIGNETTE
  AUTORISATION_TRANSPORT
  CARTE_BRUNE_CEDEAO // assurance auto transfrontalière CEDEAO (voyages internationaux)
  AUTRE
}

model Echeance {
  id             String       @id @default(cuid())
  camion         Camion       @relation(fields: [camionId], references: [id])
  camionId       String
  type           TypeEcheance
  /// Numéro de police d'assurance, de carte brune, de vignette…
  /// Ce qu'on doit pouvoir citer au poste-frontière sans sortir le papier.
  numero         String?
  /// Compagnie d'assurance ou organisme émetteur.
  organisme      String?
  /// Date de prise d'effet, quand elle est connue.
  dateDebut      DateTime?
  dateExpiration DateTime
  /// Coût du document, pour qu'il pèse sur la rentabilité du camion.
  montantGnf     Decimal?     @db.Decimal(16, 2)
  rappelJours    Int          @default(30) // alerte X jours avant
  createdAt      DateTime     @default(now())

  @@index([camionId])
}

// ------------------------------------------------------------
//  ALERTES  (fil de notifications — échéances, entretien, conso…)
//  Certaines sont dérivées de règles (échéance proche, entretien
//  dû, conso anormale) et matérialisées ici pour le suivi lu/résolu.
// ------------------------------------------------------------

enum TypeAlerte {
  ECHEANCE_DOC // assurance, visite technique…
  CARTE_BRUNE // assurance transfrontalière proche de l'expiration
  ENTRETIEN_DU // vidange / entretien groupe froid à échéance
  RUPTURE_FROID // dépassement du seuil de température (chaîne du froid)
  CONSO_ANORMALE // litres/100km ou litres/h hors norme
  CAISSE // solde chauffeur à justifier
  IMMOBILISATION // camion à l'arrêt (réparation)
  AUTRE
}

enum SeveriteAlerte {
  INFO
  ATTENTION
  URGENT
}

model Alerte {
  id        String         @id @default(cuid())
  type      TypeAlerte
  severite  SeveriteAlerte @default(ATTENTION)
  message   String
  resolue   Boolean        @default(false)
  createdAt DateTime       @default(now())

  camion      Camion?    @relation(fields: [camionId], references: [id])
  camionId    String?
  voyage      Voyage?    @relation(fields: [voyageId], references: [id])
  voyageId    String?
  chauffeur   Chauffeur? @relation(fields: [chauffeurId], references: [id])
  chauffeurId String?
}

// ------------------------------------------------------------
//  ÉTAPES DE VOYAGE  (trajet réel : arrêts, détours, changement
//  de destination signalés par le chauffeur en cours de route)
//  Ex. Koundara → Rosso en passant d'abord par Dakar.
// ------------------------------------------------------------

/**
 * Segment du trajet auquel une dépense se rapporte.
 * Le gasoil ne se donne pas toujours en une fois : on carbure pour l'aller,
 * puis on recharge au retour — ou on fait le plein une seule fois pour les
 * deux. Sans cette distinction, impossible de dire si le retour a coûté plus
 * cher que l'aller, ni de vérifier un plein annoncé pour l'aller-retour.
 */
enum SegmentTrajet {
  ALLER
  RETOUR
  ALLER_RETOUR
}

enum TypeEtape {
  ETAPE // point de passage
  ARRET // arrêt signalé (pause, contrôle, autre motif)
  CHANGEMENT_DESTINATION // le chauffeur change la destination en route
  ATTENTE_CHARGEMENT // attente sur place avant le chargement
  CHARGEMENT // chargement de la marchandise
}

model EtapeVoyage {
  id       String    @id @default(cuid())
  voyage   Voyage    @relation(fields: [voyageId], references: [id])
  voyageId String
  ordre    Int // position dans le trajet réel
  type     TypeEtape @default(ETAPE)

  // chaque étape est un TRONÇON : ville + km + carburant, au départ ET à l'arrivée
  villeDepart             String
  villeArrivee            String
  paysDepart              Pays?    @relation("EtapeDepart", fields: [paysDepartId], references: [id], onDelete: SetNull)
  paysDepartId            String?
  paysArrivee             Pays?    @relation("EtapeArrivee", fields: [paysArriveeId], references: [id], onDelete: SetNull)
  paysArriveeId           String?
  kmDepart                Int?
  kmArrivee               Int?
  carburantRestantDepart  Decimal? @db.Decimal(8, 2) // litres RESTANTS dans le réservoir au départ
  carburantRestantArrivee Decimal? @db.Decimal(8, 2) // litres restants à l'arrivée
  // conso tronçon = restantDepart + Σ(pleins de l'étape) − restantArrivee

  motif     String? // raison de l'arrêt / du détour
  departLe  DateTime?
  arriveeLe DateTime?
  createdAt DateTime  @default(now())

  ravitaillements Depense[] // pleins (ravitaillements) faits pendant ce tronçon
}

// ------------------------------------------------------------
//  CHAÎNE DU FROID — relevés de température (preuve + alerte rupture)
// ------------------------------------------------------------

enum ConformiteFroid {
  CONFORME
  ALERTE // proche du seuil
  RUPTURE // seuil dépassé — marchandise en risque
}

model ReleveTemperature {
  id          String          @id @default(cuid())
  voyage      Voyage          @relation(fields: [voyageId], references: [id])
  voyageId    String
  temperature Decimal         @db.Decimal(4, 1) // °C mesuré dans la remorque
  consigne    Decimal?        @db.Decimal(4, 1)
  conformite  ConformiteFroid @default(CONFORME)
  releveLe    DateTime        @default(now())
}

// ------------------------------------------------------------
//  CLIENTS & FACTURATION (trésorerie / créances)
// ------------------------------------------------------------

model Client {
  id               String   @id @default(cuid())
  nom              String
  telephone        String?  @unique
  ville            String? // lieu
  adresse          String?
  email            String?
  contact          String? // personne de contact
  /**
   * Ligne directe de la personne de contact.
   * Le numéro de l'entreprise est souvent un standard ou celui du gérant ;
   * l'interlocuteur qui suit réellement les livraisons a le sien. Sans ce
   * champ, on notait son numéro dans le nom du contact — introuvable à la
   * recherche et inutilisable pour un envoi.
   */
  telephoneContact String?
  nif              String? // pour la facturation
  createdAt        DateTime @default(now())

  voyages        Voyage[]
  depenses       Depense[]
  lignes         LigneMarchandise[]
  factures       Facture[]
  reclamations   Reclamation[]
  notifications  NotificationSms[]
  /// Joignable sur WhatsApp — coché à la main : aucune API ne permet de
  /// le détecter de façon fiable.
  whatsapp       Boolean            @default(false)
  /// Numéro WhatsApp s'il diffère du téléphone principal.
  whatsappNumero String?
}

enum StatutFacture {
  EMISE
  PARTIELLE
  PAYEE
  EN_RETARD
}

model Facture {
  id                    String        @id @default(cuid())
  numero                String        @unique
  client                Client        @relation(fields: [clientId], references: [id])
  clientId              String
  voyage                Voyage?       @relation(fields: [voyageId], references: [id])
  voyageId              String?
  montant               Decimal       @db.Decimal(14, 2)
  devise                Devise        @default(GNF)
  montantGnf            Decimal       @default(0) @db.Decimal(16, 2)
  /// Date d'émission portée sur le document.
  ///
  /// Distincte de `createdAt` : une facture peut être saisie plusieurs jours
  /// après avoir été établie. Confondre les deux produit des documents
  /// incohérents — une échéance antérieure à l'émission, par exemple.
  dateEmission          DateTime      @default(now())
  echeance              DateTime?
  statut                StatutFacture @default(EMISE)
  marchandiseAssuree    Boolean       @default(false) // case cochée sur la facture
  tauxPenaliteRetard    Decimal?      @db.Decimal(5, 2) // %/mois, indiqué PAR facture
  afficherEquivalentCfa Boolean       @default(true) // afficher le montant en CFA sur la facture
  /// Cumul des versements, recalculé à chaque écriture depuis `paiements`.
  /// Conservé en colonne car `creances()` et tous les écrans s'y réfèrent.
  montantPayeGnf        Decimal       @default(0) @db.Decimal(16, 2) // réglé à ce jour
  datePaiement          DateTime? // paiement SOLDÉ (dernier versement → statut PAYEE)
  createdAt             DateTime      @default(now())

  reclamations  Reclamation[]
  paiements     Paiement[]
  notifications NotificationSms[]
}

// ------------------------------------------------------------
//  PARAMÈTRES — configuration de la plateforme (ligne unique)
//  Toutes les données de l'entreprise et les constantes ; lues
//  par les factures, les alertes et les conversions.
// ------------------------------------------------------------

model Parametres {
  id String @id @default(cuid())

  // Identité (apparaît sur les factures)
  raisonSociale String
  adresse       String?
  telephone     String?
  email         String?
  rccm          String?
  nif           String?
  logoUrl       String?
  /**
   * Icône carrée de l'application : onglet du navigateur, écran d'accueil.
   * Distincte du logo, et c'est volontaire : un logo large qui porte le nom de
   * l'entreprise devient illisible à seize pixels. Une icône veut un monogramme
   * ou un symbole. Laissée vide, on retombe sur le logo, puis sur la marque.
   */
  iconeUrl      String?

  // Paiement
  orangeMoney    String?
  banque         String?
  compteBancaire String?

  // Facturation
  prefixeFacture     String  @default("FAC")
  tvaTaux            Decimal @default(0) @db.Decimal(5, 2) // % (0 = exonéré)
  delaiPaiementJours Int     @default(14) // durée d'échéance de paiement (globale)
  conditionsPaiement String?

  // Devises
  deviseBase       Devise   @default(GNF)
  tauxReferenceXof Decimal? @db.Decimal(14, 4) // GNF pour 1 XOF (pré-remplissage des saisies)

  // Chaîne du froid & alertes (valeurs par défaut / seuils)
  consigneFroidDefaut Decimal? @db.Decimal(4, 1)
  toleranceFroid      Decimal? @default(1.0) @db.Decimal(3, 1)
  rappelEcheanceJours Int      @default(30)
  seuilConsoAnormale  Decimal? @db.Decimal(5, 1) // L/100km au-delà = alerte

  // --- Notifications SMS (Nimba SMS) ---
  /// Interrupteur général. Tant qu'il est faux, rien ne part : les messages
  /// sont seulement mis en file, consultables et rejouables.
  smsActif                Boolean @default(false)
  /// Nom d'expéditeur affiché, sensible à la casse chez Nimba.
  smsExpediteur           String?
  /// URL publique de l'application, pour composer les liens de facture.
  urlApplication          String?
  // Déclencheurs, activables un par un
  smsChauffeurAffectation Boolean @default(true)
  smsClientDepart         Boolean @default(true)
  smsClientArrivee        Boolean @default(true)
  smsClientLivraison      Boolean @default(true)
  smsClientFacture        Boolean @default(true)
  smsClientRelance        Boolean @default(false)
  /// Privilégier WhatsApp quand le destinataire y est joignable.
  whatsappActif           Boolean @default(false)

  /**
   * Ouvre les carrosseries de transport de personnes (bus, taxi).
   * Décoché tant que ces véhicules ne sont pas acquis : les proposer
   * laisserait croire que l'application sait les suivre, alors que tout le
   * modèle repose sur une marchandise et un client. Le tonnage, l'écart de
   * livraison et la chaîne du froid n'ont aucun sens pour des passagers.
   */
  transportPersonnesActif Boolean @default(false)

  /// Indemnité de nourriture par jour, appliquée à défaut de barème sur la
  /// fiche du chauffeur.
  perDiemJournalierGnf Decimal? @db.Decimal(14, 2)

  // --- Caisse de l'entreprise ---
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * Argent déjà détenu au démarrage de l'application.
   * Sans lui, la trésorerie partirait de zéro et afficherait un solde négatif
   * dès la première dépense, alors que l'exploitation tournait avant.
   */
  soldeCaisseInitial Decimal?  @db.Decimal(16, 2)
  /// Date à laquelle ce solde a été constaté.
  dateSoldeInitial   DateTime?

  // --- Écran d'accueil / connexion ---
  /// Tous les textes de la page de connexion sont éditables ici : ils portent
  /// le nom de l'exploitation et son discours, qui n'ont pas à vivre dans le
  /// code. Laissés vides, les libellés d'origine s'affichent.
  accueilSurtitre     String?
  accueilTitre        String?
  accueilTexte        String?
  accueilMention      String?
  connexionSousTitre  String?
  /// Affiche les identifiants de démonstration sous le formulaire.
  /// Faux par défaut : en production, publier des comptes valides sur une page
  /// ouverte à tous reviendrait à laisser la porte déverrouillée.
  accueilAfficherDemo Boolean @default(false)

  /**
   * Montre le code de retrait à l'écran, au gérant.
   * Le code protège la livraison : il ne doit circuler qu'entre le client et
   * le chauffeur. L'afficher permet de dérouler une démonstration sans SMS
   * réel — d'où le défaut à faux, et l'avertissement sur l'écran Paramètres.
   */
  afficherCodeLivraison Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// Moyens de règlement usuels — repris des Paramètres pour la facture.
/**
 * Moyens de paiement, tenus par l'exploitation.
 * C'était une énumération figée dans le code : ajouter Wave, MTN Money ou un
 * opérateur local demandait un déploiement. Or les moyens de paiement
 * apparaissent et disparaissent plus vite que l'application, et une opération
 * qu'on ne peut pas qualifier finit saisie en « Autre » — ce qui la rend
 * introuvable au moment de la rapprocher d'un relevé.
 */
model MoyenPaiement {
  id String @id @default(cuid())

  /// Code stable, indépendant du libellé : les reprises s'y accrochent.
  code  String  @unique
  nom   String  @unique
  ordre Int     @default(100)
  actif Boolean @default(true)

  paiements  Paiement[]
  mouvements MouvementCaisse[]
  depenses   Depense[]

  @@index([actif, ordre])
}

/// Un versement sur une facture. Une facture réglée en plusieurs fois porte
/// autant de lignes que d'échéances honorées : sans ce détail, on connaîtrait
/// le cumul sans savoir quand ni comment le client a payé.
model Paiement {
  id         String            @id @default(cuid())
  facture    Facture           @relation(fields: [factureId], references: [id], onDelete: Cascade)
  factureId  String
  montant    Decimal           @db.Decimal(14, 2)
  devise     Devise            @default(GNF)
  /// Équivalent GNF figé au taux réel du jour du versement.
  montantGnf Decimal           @db.Decimal(16, 2)
  date       DateTime          @default(now())
  moyen      MoyenPaiement?    @relation(fields: [moyenId], references: [id])
  moyenId    String?
  /// Référence du transfert, numéro de chèque, identifiant Orange Money…
  reference  String?
  note       String?
  createdAt  DateTime          @default(now())
  /// Où l'argent a été encaissé.
  compte     CompteTresorerie? @relation(fields: [compteId], references: [id])
  compteId   String?

  @@index([factureId, date])
}

/// Événement métier qui déclenche un SMS.
enum EvenementSms {
  CHAUFFEUR_AFFECTATION // mission attribuée à un chauffeur
  CLIENT_DEPART // marchandise chargée, camion parti
  CLIENT_ARRIVEE // arrivé à destination
  CLIENT_LIVRAISON // livraison confirmée
  CLIENT_FACTURE // facture émise, avec son lien
  CLIENT_RELANCE // relance d'une facture échue
  CLIENT_CODE_LIVRAISON // code de retrait, à remettre au chauffeur
  AUTRE
}

/// Canal d'acheminement. WhatsApp passe par le même fournisseur (Nimba),
/// mais impose des gabarits validés par Meta : on ne peut pas y envoyer du
/// texte libre comme en SMS.
enum CanalMessage {
  SMS
  WHATSAPP
}

enum StatutSms {
  EN_ATTENTE // en file : SMS désactivé ou clés API absentes
  ENVOYE
  ECHEC
  ANNULE
}

/// File d'attente et journal des SMS.
///
/// Chaque notification est écrite ici AVANT toute tentative d'envoi. Sans clés
/// API, elle reste simplement `EN_ATTENTE` : rien n'est perdu, tout est
/// consultable, et la file se rejoue une fois les identifiants renseignés.
model NotificationSms {
  id           String        @id @default(cuid())
  evenement    EvenementSms
  canal        CanalMessage  @default(SMS)
  /// Canal réellement utilisé si le premier a échoué et qu'on a basculé.
  canalUtilise CanalMessage?
  /// Numéro au format international, tel qu'envoyé à Nimba.
  destinataire String
  /// Nom lisible du destinataire, pour l'écran de suivi.
  nom          String?
  message      String
  statut       StatutSms     @default(EN_ATTENTE)
  /// Identifiant renvoyé par Nimba, pour le suivi de livraison.
  referenceApi String?
  erreur       String?
  tentatives   Int           @default(0)
  envoyeLe     DateTime?
  createdAt    DateTime      @default(now())

  voyage      Voyage?    @relation(fields: [voyageId], references: [id], onDelete: SetNull)
  voyageId    String?
  facture     Facture?   @relation(fields: [factureId], references: [id], onDelete: SetNull)
  factureId   String?
  chauffeur   Chauffeur? @relation(fields: [chauffeurId], references: [id], onDelete: SetNull)
  chauffeurId String?
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId    String?

  @@index([statut, createdAt])
}

/// Prélèvement en nature sur la marchandise, à un poste de contrôle.
///
/// À distinguer d'une dépense de douane payée en argent (voir `Depense`) :
/// ici la douane retient une PART DE LA MARCHANDISE. Sans ce suivi, l'écart
/// entre quantité reçue et livrée serait imputé au chauffeur comme une perte
/// ou un vol, alors qu'il est parfaitement régulier.
model PrelevementDouane {
  id         String           @id @default(cuid())
  voyage     Voyage           @relation(fields: [voyageId], references: [id], onDelete: Cascade)
  voyageId   String
  /// Marchandise sur laquelle le poste a retenu. Sans elle, un manquant ne
  /// pourrait pas être imputé à la bonne ligne d'un chargement mixte.
  ligne      LigneMarchandise @relation(fields: [ligneId], references: [id], onDelete: Cascade)
  ligneId    String
  /// Quantité retenue, exprimée dans l'unité de la ligne.
  quantite   Decimal          @db.Decimal(14, 3)
  lieu       String
  pays       Pays?            @relation(fields: [paysId], references: [id], onDelete: SetNull)
  paysId     String?
  motif      String?
  /// Certains postes convertissent le prélèvement en argent : on garde la
  /// contrepartie quand elle existe, au taux réel comme partout ailleurs.
  montant    Decimal?         @db.Decimal(14, 2)
  devise     Devise           @default(GNF)
  montantGnf Decimal?         @db.Decimal(16, 2)
  /// Référence du reçu remis au chauffeur, s'il y en a un.
  reference  String?
  date       DateTime         @default(now())
  createdAt  DateTime         @default(now())

  @@index([voyageId])
}

// ------------------------------------------------------------
//  RÉCLAMATIONS — litiges clients (quantité contestée, qualité…)
//  Reliées à la mission, au client et à la facture ; résolution
//  possible par avoir / remise / rejet motivé.
// ------------------------------------------------------------

enum TypeReclamation {
  QUANTITE // quantité livrée contestée
  QUALITE // état de la marchandise
  RETARD // livraison en retard
  RUPTURE_FROID // chaîne du froid rompue
  AUTRE
}

enum StatutReclamation {
  OUVERTE
  EN_COURS
  RESOLUE
  REJETEE
}

model Reclamation {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id])
  clientId  String
  voyage    Voyage?  @relation(fields: [voyageId], references: [id])
  voyageId  String?
  facture   Facture? @relation(fields: [factureId], references: [id])
  factureId String?

  /// Marchandise contestée, quand la réclamation porte sur une quantité.
  ligne   LigneMarchandise? @relation(fields: [ligneId], references: [id])
  ligneId String?

  type              TypeReclamation
  description       String
  /// Quantité que le client déclare avoir reçue, dans l'unité de la ligne.
  quantiteContestee Decimal?        @db.Decimal(14, 3)

  statut          StatutReclamation @default(OUVERTE)
  resolution      String? // geste commercial, avoir, remboursement, rejet motivé
  montantAvoirGnf Decimal?          @db.Decimal(16, 2) // avoir / remise accordé

  dateOuverture  DateTime  @default(now())
  dateResolution DateTime?
}

/**
 * Saisies du chauffeur déjà appliquées, identifiées côté téléphone.
 * Hors réseau, une saisie est mise en file sur l'appareil puis rejouée au
 * retour du réseau. Le rejeu peut se produire deux fois — envoi parti mais
 * réponse perdue, onglet rouvert, deux appareils. Sans cette table, une
 * avance de mission serait comptée deux fois dans la caisse et un statut
 * sauterait une étape.
 * L'identifiant vient du téléphone : c'est lui qui garantit qu'une saisie
 * n'est appliquée qu'une fois, quel que soit le nombre d'envois.
 */
model OperationChauffeur {
  id          String    @id
  chauffeur   Chauffeur @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)
  chauffeurId String
  /// Nom de l'action rejouée, tel que la file l'a enregistré.
  action      String
  /// Saisie faite hors ligne — sert à dater l'opération au bon moment.
  saisieLe    DateTime
  traiteeLe   DateTime  @default(now())

  @@index([chauffeurId, traiteeLe])
}

/**
 * Journal des opérations : qui a fait quoi, quand.
 * Sans lui, personne ne peut dire qui a saisi un règlement, modifié un montant
 * ou supprimé une avance. Dans une exploitation où l'argent circule de la main
 * à la main, c'est la seule pièce qui permet de remonter une opération
 * contestée — et la première qu'un comptable externe ou un bailleur réclame.
 * Les lignes ne se modifient ni ne se suppriment : un journal qu'on peut
 * réécrire ne prouve rien.
 */
model Journal {
  id String @id @default(cuid())

  date DateTime @default(now())

  /**
   * Auteur de l'opération.
   * Le lien peut se rompre — un compte se supprime — mais le nom reste figé :
   * une trace qui perd son auteur ne sert plus à rien.
   */
  auteur     Utilisateur? @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  auteurId   String?
  auteurNom  String
  auteurRole String

  /// Identifiant technique de l'action : `facture.paiement.enregistre`.
  action  String
  /// Type d'objet touché, pour filtrer : `Facture`, `MouvementCaisse`…
  objet   String
  objetId String?

  /// Phrase lisible telle qu'elle s'affiche dans l'historique.
  libelle String

  /// Montant concerné, s'il y en a un : permet de retrouver une somme précise.
  montantGnf Decimal? @db.Decimal(16, 2)

  /// État avant et après, pour les modifications de valeurs sensibles.
  avant Json?
  apres Json?

  @@index([date])
  @@index([objet, objetId])
  @@index([auteurId, date])
}

// ------------------------------------------------------------
//  Trésorerie : où se trouve l'argent
// ------------------------------------------------------------

enum TypeCompte {
  CAISSE // espèces détenues au bureau
  BANQUE
  MOBILE_MONEY
  CHAUFFEUR // argent confié à un chauffeur, qu'il devra justifier
}

/**
 * Un emplacement où de l'argent se trouve réellement.
 * Un solde global ne dit rien d'exploitable : savoir qu'on détient quinze
 * millions ne dit pas si on peut payer un fournisseur aujourd'hui. Ce qui
 * compte, c'est où est cet argent — en banque, dans le coffre, sur un compte
 * Orange Money, ou dans la poche d'un chauffeur parti à Dakar.
 */
model CompteTresorerie {
  id String @id @default(cuid())

  nom       String     @unique
  type      TypeCompte
  /// Numéro de compte, de téléphone, ou emplacement physique du coffre.
  reference String?

  /// Devise du compte. Un compte bancaire en CFA ne se mélange pas au GNF.
  devise Devise @default(GNF)

  /**
   * Argent déjà présent à l'ouverture du compte dans l'application.
   * Sans lui, chaque compte partirait de zéro et afficherait un solde négatif
   * dès la première sortie, alors que l'exploitation tournait avant.
   */
  soldeInitial     Decimal   @default(0) @db.Decimal(16, 2)
  dateSoldeInitial DateTime?

  /**
   * Compte porté par un chauffeur.
   * Son solde EST la caisse du chauffeur : les avances qu'on lui remet et les
   * dépenses qu'il justifie s'y inscrivent. Un chauffeur n'a qu'un compte.
   */
  chauffeur   Chauffeur? @relation(fields: [chauffeurId], references: [id], onDelete: Cascade)
  chauffeurId String?    @unique

  actif Boolean @default(true)
  ordre Int     @default(100)

  operations       OperationTresorerie[] @relation("CompteOperation")
  operationsRecues OperationTresorerie[] @relation("CompteContrepartie")
  paiements        Paiement[]
  depenses         Depense[]
  mouvementsCaisse MouvementCaisse[]

  @@index([actif, ordre])
}

enum MotifTresorerie {
  DEPOT // de la caisse vers la banque, ou apport extérieur
  RETRAIT // de la banque vers la caisse
  TRANSFERT // entre deux comptes de l'exploitation
  APPORT // argent injecté par le gérant ou un associé
  PRELEVEMENT // argent sorti de l'exploitation
  AJUSTEMENT // écart constaté à un comptage physique
}

/**
 * Mouvement d'argent qui ne correspond à aucune opération commerciale.
 * Un règlement client, une dépense ou une avance sont déjà enregistrés comme
 * tels, et portent leur compte. Restent les mouvements purement financiers —
 * déposer les espèces à la banque, retirer pour payer un garage, virer d'un
 * compte Orange Money vers un autre, constater un écart de comptage. Sans eux,
 * le solde par emplacement serait faux dès le premier dépôt.
 */
model OperationTresorerie {
  id String @id @default(cuid())

  compte   CompteTresorerie @relation("CompteOperation", fields: [compteId], references: [id])
  compteId String

  /**
   * Compte destinataire d'un transfert.
   * Un transfert est UNE opération, pas deux : la sortie et l'entrée sont le
   * même événement. Deux écritures séparées finiraient par diverger — l'une
   * corrigée, l'autre oubliée.
   */
  vers   CompteTresorerie? @relation("CompteContrepartie", fields: [versId], references: [id])
  versId String?

  motif MotifTresorerie

  montant    Decimal @db.Decimal(16, 2)
  devise     Devise  @default(GNF)
  /// Équivalent GNF figé au taux réel du jour.
  montantGnf Decimal @db.Decimal(16, 2)

  /**
   * Frais prélevés par l'opérateur ou la banque sur l'opération.
   * Retirer un million au guichet n'en coûte pas un million : la commission
   * est un vrai coût, et elle sort de la caisse sans arriver nulle part.
   */
  fraisGnf Decimal? @db.Decimal(14, 2)

  date      DateTime @default(now())
  libelle   String?
  reference String?

  createdAt DateTime @default(now())

  @@index([compteId, date])
  @@index([date])
}
